    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@swc/core": "^1.13.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^9.36.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
